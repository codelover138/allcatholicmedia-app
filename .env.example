# Copy this file to .env.local and adjust for your machine.
# Expo automatically loads .env / .env.local — no extra tooling needed.
# Any var prefixed EXPO_PUBLIC_ is inlined into the JS bundle at build time
# (visible to the client — never put secrets here).

# Base URL for the Laravel API (../main), no trailing slash, no /home etc.
#
# - Web / iOS Simulator (same machine as the backend): http://localhost/main/public/api/app
# - Android Emulator (localhost = the emulator itself, not your PC):
#     http://10.0.2.2/main/public/api/app
# - Physical device via Expo Go (must be on the same Wi-Fi as this PC):
#     http://<your-pc-LAN-IP>/main/public/api/app
# - Staging/production: point at the real domain, e.g. https://allcatholicmedia.com/api/app
EXPO_PUBLIC_API_BASE_URL=http://localhost/main/public/api/app
